# 닿는제주 설정 예시. API 키는 로컬 .env에만 입력하세요.

# ===== LLM (선택) — 없으면 규칙 모드로 동작 =====
LLM_PROVIDER=none          # none / openai / gemini / claude
LLM_API_KEY=
LLM_MODEL=                 # 기본: OpenAI gpt-6-luna / Gemini gemini-3.5-flash-lite / Claude claude-haiku-5-5
LLM_TIMEOUT=20
LLM_DAILY_LIMIT=            # 빈 값 또는 0: 제한 없음, 양수: 하루 호출 상한

# ===== 기상청 단기예보 (선택) — 공공데이터포털 인증키(Decoding) =====
KMA_SERVICE_KEY=
# ===== 경로 (보통 비워 두면 기본값 사용) =====
DB_PATH=
EXTRA_DIR=
KTO_SERVICE_KEY=
LLM_USD_KRW=1400           # 참고용 가정 환율(실시간 환율 아님), 비용 표시에만 사용

# ===== 브이월드 배경지도(선택) — 없거나 타일 실패 시 기존 CARTO light → 실패 시 OSM =====
VWORLD_API_KEY=
VWORLD_SERVICE_URL=        # 선택: 키에 등록한 실제 운영 서비스 URL. 다른 도메인으로 가장하지 말 것

# 지도 표시 엔진 (leaflet / pydeck)
MAP_ENGINE=leaflet
MAP_TILE_PORT=18769
